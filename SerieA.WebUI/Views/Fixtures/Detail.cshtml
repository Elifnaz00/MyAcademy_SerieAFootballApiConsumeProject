    </main>

    <script>

        (function () {

            'use strict';

            const root = document.querySelector('[data-match]');

            if (!root) return;


            const chips = Array.from(
                root.querySelectorAll('[data-event-filter]')
            );

            const events = Array.from(
                root.querySelectorAll('.event[data-type]')
            );


            function setFilter(type) {

                chips.forEach((chip) => {

                    chip.setAttribute(
                        'aria-pressed',
                        String(chip.dataset.eventFilter === type)
                    );

                });


                events.forEach((event) => {

                    event.hidden =
                        type !== 'all' &&
                        event.dataset.type !== type;

                });

            }


            chips.forEach((chip) => {

                chip.addEventListener(
                    'click',
                    () => setFilter(chip.dataset.eventFilter)
                );

            });

        })();

    </script>

