@model SerieA.WebUI.ViewModels.MatchDetailViewModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    
    <title>@Model.HomeTeamName - @Model.AwayTeamName | Serie A</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Barlow+Condensed:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #070F1F;
            --bg-2: #0B1730;
            --surface: #0F1D38;
            --surface-2: #142647;
            --line: #1F3358;
            --text: #E9F0FB;
            --text-2: #C4D0E6;
            --muted: #8B9CC0;
            --blue: #2E7BFF;
            --blue-bright: #5B9BFF;
            --green: #1FC98A;
            --amber: #F2C037;
            --red: #F2475C;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: radial-gradient(circle at top left, rgba(46,123,255,.10), transparent 32%), var(--bg);
            color: var(--text);
            font-family: "Barlow", sans-serif;
        }

        .match-shell {
            padding-top: 35px;
            padding-bottom: 50px;
        }

        .match-hero {
            background: linear-gradient(135deg, #0F1D38, #0B1730);
            border: 1px solid var(--line);
            border-radius: 22px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0,0,0,.25);
        }

        .hero-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
        }

        .hero-week {
            color: var(--muted);
            font-weight: 600;
            font-size: 14px;
        }

        .hero-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 13px;
            border-radius: 999px;
            background: rgba(31,201,138,.10);
            color: var(--green);
            font-size: 13px;
            font-weight: 700;
        }

            .hero-status::before {
                content: "";
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: currentColor;
            }

        .teams {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 30px;
        }

        .team {
            text-align: center;
        }

        .team-name {
            font-family: "Barlow Condensed", sans-serif;
            font-size: 28px;
            font-weight: 700;
            margin-top: 12px;
        }

        .team-crest {
            width: 80px;
            height: 80px;
            margin: auto;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--surface-2);
            border: 1px solid var(--line);
            font-family: "Barlow Condensed", sans-serif;
            font-size: 20px;
            font-weight: 800;
            color: var(--blue-bright);
        }

        .score-box {
            text-align: center;
        }

        .score {
            font-family: "Barlow Condensed", sans-serif;
            font-size: 68px;
            line-height: .9;
            font-weight: 800;
            letter-spacing: -2px;
        }

        .match-date {
            margin-top: 12px;
            color: var(--muted);
            font-size: 14px;
        }

        .stadium {
            color: var(--text-2);
            font-size: 14px;
            margin-top: 4px;
        }

        .scorers {
            display: flex;
            justify-content: space-between;
            gap: 30px;
            margin-top: 25px;
        }

        .scorer-list {
            flex: 1;
        }

            .scorer-list.right {
                text-align: right;
            }

        .scorer {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin: 3px 0;
            color: var(--text-2);
            font-size: 14px;
        }

        .scorer-minute {
            color: var(--green);
            font-weight: 700;
        }

        .section-card {
            margin-top: 24px;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 24px;
        }

        .section-title {
            font-family: "Barlow Condensed", sans-serif;
            font-size: 25px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .event-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 20px;
        }

        .filter-chip {
            border: 1px solid var(--line);
            background: var(--surface-2);
            color: var(--text-2);
            padding: 7px 13px;
            border-radius: 999px;
            font-size: 13px;
            cursor: pointer;
        }

            .filter-chip[aria-pressed="true"] {
                background: var(--blue);
                border-color: var(--blue);
                color: white;
            }

        .timeline {
            position: relative;
        }

        .event {
            display: flex;
            gap: 15px;
            padding: 13px 0;
            border-bottom: 1px solid rgba(255,255,255,.05);
        }

            .event:last-child {
                border-bottom: 0;
            }

        .event-minute {
            width: 45px;
            color: var(--muted);
            font-weight: 700;
        }

        .event-icon {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--surface-2);
        }

        .event-content {
            flex: 1;
        }

        .event-title {
            font-weight: 700;
        }

        .event-description {
            color: var(--muted);
            font-size: 13px;
            margin-top: 2px;
        }

        .event-home {
            text-align: right;
        }

        .match-panels {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-top: 24px;
        }

        .panel {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 24px;
        }

        .panel-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: "Barlow Condensed", sans-serif;
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .panel-count {
            color: var(--muted);
            font-size: 14px;
            font-family: "Barlow", sans-serif;
        }

        .team-detail {
            margin-bottom: 24px;
        }

            .team-detail:last-child {
                margin-bottom: 0;
            }

        .team-detail-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 10px;
            margin-bottom: 10px;
            border-bottom: 1px solid var(--line);
        }

        .team-detail-name {
            font-weight: 700;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 9px 0;
            color: var(--text-2);
            border-bottom: 1px solid rgba(255,255,255,.04);
        }

            .detail-row:last-child {
                border-bottom: 0;
            }

        .minute {
            color: var(--muted);
            font-size: 13px;
            min-width: 42px;
        }

        .player {
            flex: 1;
        }

        .empty-state {
            color: var(--muted);
            font-size: 14px;
            padding: 10px 0;
        }

        .card-icon {
            width: 12px;
            height: 17px;
            border-radius: 2px;
            display: inline-block;
            margin-right: 8px;
            vertical-align: middle;
        }

        .yellow-card {
            background: var(--amber);
        }

        .red-card {
            background: var(--red);
        }

        .sub-arrow {
            color: var(--green);
            font-weight: 800;
            margin: 0 5px;
        }

        .period-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .period-card {
            background: var(--surface-2);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 18px;
            text-align: center;
        }

        .period-label {
            color: var(--muted);
            font-size: 13px;
            margin-bottom: 7px;
        }

        .period-score {
            font-family: "Barlow Condensed", sans-serif;
            font-size: 34px;
            font-weight: 800;
        }

        .period-note {
            color: var(--text-2);
            font-size: 13px;
            margin-top: 4px;
        }

        .stats-grid {
            display: grid;
            gap: 16px;
        }

        .stat-row {
            display: grid;
            grid-template-columns: 70px 1fr 70px;
            align-items: center;
            gap: 12px;
        }

        .stat-value {
            font-weight: 700;
            text-align: center;
        }

        .stat-label {
            text-align: center;
            color: var(--muted);
            font-size: 13px;
        }

        .stat-bar {
            height: 7px;
            border-radius: 999px;
            background: var(--surface-2);
            overflow: hidden;
        }

        .stat-fill {
            height: 100%;
            background: var(--blue);
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .info-box {
            background: var(--surface-2);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 16px;
        }

        .info-label {
            color: var(--muted);
            font-size: 12px;
            margin-bottom: 4px;
        }

        .info-value {
            font-weight: 700;
        }

        footer {
            text-align: center;
            color: var(--muted);
            font-size: 13px;
            margin-top: 30px;
        }

        @@media (max-width: 767px) {
            .match-shell

        {
            padding-top: 15px;
        }

        .match-hero,
        .section-card,
        .panel {
            padding: 18px;
        }

        .teams {
            gap: 10px;
        }

        .team-name {
            font-size: 22px;
        }

        .team-crest {
            width: 62px;
            height: 62px;
        }

        .score {
            font-size: 48px;
        }

        .scorers {
            gap: 10px;
        }

        .match-panels {
            grid-template-columns: 1fr;
        }

        .period-grid {
            grid-template-columns: 1fr;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        }
    </style>
    

</head>

<body>

    <main class="match-shell container-xl" data-match>

        
        <!-- ==================== HERO ==================== -->

        <header class="match-hero">

            <div class="hero-top">

                <div class="hero-week">
                    Serie A · Hafta @Model.Week
                </div>

                <div class="hero-status">
                    Maç bitti
                </div>

            </div>

            <div class="teams">

                <div class="team">

                    <div class="team-crest">
                        @(Model.HomeTeamName.Length >= 3
                                                ? Model.HomeTeamName.Substring(0, 3).ToUpper()
                                                : Model.HomeTeamName.ToUpper())
                    </div>

                    <div class="team-name">
                        @Model.HomeTeamName
                    </div>

                </div>


                <div class="score-box">

                    <div class="score">
                        @Model.HomeScore - @Model.AwayScore
                    </div>

                    <div class="match-date">
                        @Model.MatchDate.ToString("dd.MM.yyyy HH:mm")
                    </div>

                    <div class="stadium">
                        @Model.Stadium
                    </div>

                </div>


                <div class="team">

                    <div class="team-crest">
                        @(Model.AwayTeamName.Length >= 3
                                                ? Model.AwayTeamName.Substring(0, 3).ToUpper()
                                                : Model.AwayTeamName.ToUpper())
                    </div>

                    <div class="team-name">
                        @Model.AwayTeamName
                    </div>

                </div>

            </div>


            <!-- Golcüler -->

            <div class="scorers">

                <div class="scorer-list" aria-label="@Model.HomeTeamName golleri">

                    @if (Model.HomeGoals.Any())
                    {
                        foreach (var goal in Model.HomeGoals)
                        {
                            <div class="scorer">
                                <span>@goal.PlayerName</span>
                                <span class="scorer-minute">@goal.Minute'</span>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="text-muted">Gol yok</span>
                    }

                </div>


                <div class="scorer-list right" aria-label="@Model.AwayTeamName golleri">

                    @if (Model.AwayGoals.Any())
                    {
                        foreach (var goal in Model.AwayGoals)
                        {
                            <div class="scorer">
                                <span>@goal.PlayerName</span>
                                <span class="scorer-minute">@goal.Minute'</span>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="text-muted">Gol yok</span>
                    }

                </div>

            </div>

        </header>


        <!-- ==================== MAÇ OLAYLARI ==================== -->

        <section class="section-card">

            <div class="section-title">
                Maç olayları
            </div>

            <div class="event-filters">

                <button class="filter-chip"
                        type="button"
                        data-event-filter="all"
                        aria-pressed="true">
                    Tümü
                </button>

                <button class="filter-chip"
                        type="button"
                        data-event-filter="goal"
                        aria-pressed="false">
                    Goller
                </button>

                <button class="filter-chip"
                        type="button"
                        data-event-filter="card"
                        aria-pressed="false">
                    Kartlar
                </button>

                <button class="filter-chip"
                        type="button"
                        data-event-filter="sub"
                        aria-pressed="false">
                    Değişiklikler
                </button>

            </div>

            <div class="timeline">

                <!-- Gerçek API verileri aşağıdaki panellerde gösteriliyor.
                     Birleşik timeline için API'de henüz Event DTO bulunmuyor. -->
                @foreach (var goal in Model.HomeGoals)
                {
                    <div class="event" data-type="goal">

                        <div class="event-minute">
                            @goal.Minute'
                        </div>

                        <div class="event-icon">
                            ⚽
                        </div>

                        <div class="event-content">

                            <div class="event-title">
                                @Model.HomeTeamName
                            </div>

                            <div class="event-description">
                                @goal.PlayerName gol attı
                            </div>

                        </div>

                    </div>
                }

                @foreach (var goal in Model.AwayGoals)
                {
                    <div class="event" data-type="goal">

                        <div class="event-minute">
                            @goal.Minute'
                        </div>

                        <div class="event-icon">
                            ⚽
                        </div>

                        <div class="event-content">

                            <div class="event-title">
                                @Model.AwayTeamName
                            </div>

                            <div class="event-description">
                                @goal.PlayerName gol attı
                            </div>

                        </div>

                    </div>
                }

                @foreach (var card in Model.HomeCards)
                {
                    <div class="event" data-type="card">

                        <div class="event-minute">
                            @card.Minute'
                        </div>

                        <div class="event-icon">

                            @if (card.CardType == 0)
                            {
                                <span class="card-icon yellow-card"></span>
                            }
                            else
                            {
                                <span class="card-icon red-card"></span>
                            }

                        </div>

                        <div class="event-content">

                            <div class="event-title">
                                @Model.HomeTeamName
                            </div>

                            <div class="event-description">
                                @card.PlayerName
                            </div>

                        </div>

                    </div>
                }

                @foreach (var card in Model.AwayCards)
                {
                    <div class="event" data-type="card">

                        <div class="event-minute">
                            @card.Minute'
                        </div>

                        <div class="event-icon">

                            @if (card.CardType == 0)
                            {
                                <span class="card-icon yellow-card"></span>
                            }
                            else
                            {
                                <span class="card-icon red-card"></span>
                            }

                        </div>

                        <div class="event-content">

                            <div class="event-title">
                                @Model.AwayTeamName
                            </div>

                            <div class="event-description">
                                @card.PlayerName
                            </div>

                        </div>

                    </div>
                }

                @foreach (var sub in Model.HomeSubstitutions)
                {
                    <div class="event" data-type="sub">

                        <div class="event-minute">
                            @sub.Minute'
                        </div>

                        <div class="event-icon">
                            ↔
                        </div>

                        <div class="event-content">

                            <div class="event-title">
                                @Model.HomeTeamName
                            </div>

                            <div class="event-description">
                                <span>@sub.PlayerIn</span>
                                <span class="sub-arrow">↑</span>
                                <span>@sub.PlayerOut</span>
                            </div>

                        </div>

                    </div>
                }

                @foreach (var sub in Model.AwaySubstitutions)
                {
                    <div class="event" data-type="sub">

                        <div class="event-minute">
                            @sub.Minute'
                        </div>

                        <div class="event-icon">
                            ↔
                        </div>

                        <div class="event-content">

                            <div class="event-title">
                                @Model.AwayTeamName
                            </div>

                            <div class="event-description">
                                <span>@sub.PlayerIn</span>
                                <span class="sub-arrow">↑</span>
                                <span>@sub.PlayerOut</span>
                            </div>

                        </div>

                    </div>
                }

            </div>

        </section>


        <!-- ==================== GOLLER / KARTLAR ==================== -->

        <div class="match-panels">

            <section class="panel">

                <div class="panel-title">

                    <span>Goller</span>

                    <span class="panel-count">
                        @Model.HomeGoalCount + @Model.AwayGoalCount
                    </span>

                </div>


                <div class="team-detail">

                    <div class="team-detail-header">
                        <span class="team-detail-name">
                            @Model.HomeTeamName
                        </span>

                        <strong>
                            @Model.HomeGoalCount
                        </strong>
                    </div>

                    @if (Model.HomeGoals.Any())
                    {
                        foreach (var goal in Model.HomeGoals)
                        {
                            <div class="detail-row">

                                <span class="minute">
                                    @goal.Minute'
                                </span>

                                <span class="player">
                                    @goal.PlayerName
                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            Gol yok.
                        </div>
                    }

                </div>


                <div class="team-detail">

                    <div class="team-detail-header">
                        <span class="team-detail-name">
                            @Model.AwayTeamName
                        </span>

                        <strong>
                            @Model.AwayGoalCount
                        </strong>
                    </div>

                    @if (Model.AwayGoals.Any())
                    {
                        foreach (var goal in Model.AwayGoals)
                        {
                            <div class="detail-row">

                                <span class="minute">
                                    @goal.Minute'
                                </span>

                                <span class="player">
                                    @goal.PlayerName
                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            Gol yok.
                        </div>
                    }

                </div>

            </section>


            <section class="panel">

                <div class="panel-title">

                    <span>Kartlar</span>

                    <span class="panel-count">
                        @(Model.HomeCards.Count + Model.AwayCards.Count)
                    </span>

                </div>


                <div class="team-detail">

                    <div class="team-detail-header">

                        <span class="team-detail-name">
                            @Model.HomeTeamName
                        </span>

                        <strong>
                            @Model.HomeCards.Count
                        </strong>

                    </div>

                    @if (Model.HomeCards.Any())
                    {
                        foreach (var card in Model.HomeCards)
                        {
                            <div class="detail-row">

                                <span class="minute">
                                    @card.Minute'
                                </span>

                                <span class="player">

                                    @if (card.CardType == 0)
                                    {
                                        <span class="card-icon yellow-card"></span>
                                    }
                                    else
                                    {
                                        <span class="card-icon red-card"></span>
                                    }

                                    @card.PlayerName

                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            Kart yok.
                        </div>
                    }

                </div>


                <div class="team-detail">

                    <div class="team-detail-header">

                        <span class="team-detail-name">
                            @Model.AwayTeamName
                        </span>

                        <strong>
                            @Model.AwayCards.Count
                        </strong>

                    </div>

                    @if (Model.AwayCards.Any())
                    {
                        foreach (var card in Model.AwayCards)
                        {
                            <div class="detail-row">

                                <span class="minute">
                                    @card.Minute'
                                </span>

                                <span class="player">

                                    @if (card.CardType == 0)
                                    {
                                        <span class="card-icon yellow-card"></span>
                                    }
                                    else
                                    {
                                        <span class="card-icon red-card"></span>
                                    }

                                    @card.PlayerName

                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            Kart yok.
                        </div>
                    }

                </div>

            </section>

        </div>


        <!-- ==================== DEĞİŞİKLİKLER ==================== -->

        <section class="section-card">

            <div class="section-title">
                Oyuncu değişiklikleri
            </div>


            <div class="match-panels">

                <div>

                    <div class="team-detail-header">

                        <span class="team-detail-name">
                            @Model.HomeTeamName
                        </span>

                        <strong>
                            @Model.HomeSubstitutions.Count
                        </strong>

                    </div>

                    @if (Model.HomeSubstitutions.Any())
                    {
                        foreach (var sub in Model.HomeSubstitutions)
                        {
                            <div class="detail-row">

                                <span class="minute">
                                    @sub.Minute'
                                </span>

                                <span class="player">
                                    <span style="color: var(--green);">
                                        @sub.PlayerIn
                                    </span>

                                    <span class="sub-arrow">↑</span>

                                    <span style="color: var(--muted);">
                                        @sub.PlayerOut
                                    </span>
                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            Değişiklik yok.
                        </div>
                    }

                </div>


                <div>

                    <div class="team-detail-header">

                        <span class="team-detail-name">
                            @Model.AwayTeamName
                        </span>

                        <strong>
                            @Model.AwaySubstitutions.Count
                        </strong>

                    </div>

                    @if (Model.AwaySubstitutions.Any())
                    {
                        foreach (var sub in Model.AwaySubstitutions)
                        {
                            <div class="detail-row">

                                <span class="minute">
                                    @sub.Minute'
                                </span>

                                <span class="player">

                                    <span style="color: var(--green);">
