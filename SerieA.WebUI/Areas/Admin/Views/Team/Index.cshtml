@using SerieA.WebUI.Areas.Admin.Models.TeamModels
@model List<TeamListViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>
    /* ============================================================
       Team/Index.cshtml — takıma özel CSS
       ============================================================ */

    .league-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        margin-bottom: 18px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--white);
    }

    .strip-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
    }

        .strip-item + .strip-item {
            border-left: 1px solid var(--line);
        }

    .strip-icon {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: var(--tint);
        color: var(--ink);
    }

        .strip-icon .icon {
            width: 17px;
            height: 17px;
        }

    .strip-item--green {
        --tint: var(--it-green-soft);
        --ink: var(--it-green);
    }

    .strip-item--blue {
        --tint: var(--blue-soft);
        --ink: var(--blue);
    }

    .strip-item--red {
        --tint: var(--it-red-soft);
        --ink: var(--it-red);
    }

    .strip-item--navy {
        --tint: #E6EAF2;
        --ink: var(--navy-700);
    }

    .strip-label {
        display: block;
        color: var(--muted);
        font-size: .78rem;
        font-weight: 500;
    }

    .strip-value {
        display: block;
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.1;
    }

        .strip-value small {
            color: var(--muted);
            font-family: var(--font-body);
            font-size: .78rem;
            font-weight: 500;
        }

    .team-table {
        width: 100%;
        min-width: 920px;
        border-collapse: collapse;
    }

        .team-table th {
            padding: 10px 14px;
            border-bottom: 1px solid var(--line);
            background: #F8FAFC;
            color: var(--muted);
            font-size: .78rem;
            font-weight: 600;
            text-align: left;
            white-space: nowrap;
        }

        .team-table td {
            padding: 8px 14px;
            border-bottom: 1px solid var(--line);
            color: var(--text-2);
            vertical-align: middle;
            white-space: nowrap;
        }

        .team-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .team-table tbody tr:hover td {
            background: var(--row-hover);
        }

        .team-table tbody tr.is-inactive td {
            color: var(--dim);
        }

        .team-table tbody tr.is-inactive .team-name {
            color: var(--muted);
        }

        .team-table tbody tr.is-new td {
            animation: row-flash 2.4s ease-out;
        }

    .col-id {
        width: 56px;
        color: var(--muted);
        font-weight: 600;
    }

    .col-num {
        text-align: right !important;
    }

    .col-actions {
        width: 1%;
        text-align: right !important;
    }

    .sort-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font: inherit;
        cursor: pointer;
    }

        .sort-btn:hover {
            color: var(--text);
        }

        .sort-btn::after {
            content: "↕";
            color: var(--line-strong);
            font-size: .85em;
        }

    [aria-sort="ascending"] .sort-btn::after {
        content: "↑";
        color: var(--blue);
    }

    [aria-sort="descending"] .sort-btn::after {
        content: "↓";
        color: var(--blue);
    }

    .sort-btn:focus-visible {
        outline: 2px solid var(--blue);
        outline-offset: 2px;
        border-radius: 3px;
    }

    .team-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .team-crest {
        --size: 34px;
        flex: none;
        display: inline-grid;
        place-items: center;
        width: var(--size);
        height: var(--size);
        border-radius: 50%;
        background: linear-gradient(180deg, var(--crest-a) 0 70%, var(--crest-b) 70% 100%);
        color: var(--crest-ink, #fff);
        font-family: var(--font-display);
        font-size: calc(var(--size) * .33);
        font-weight: 700;
        line-height: 1;
        padding-bottom: calc(var(--size) * .12);
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .14);
    }

    .team-crest--lg {
        --size: 64px;
    }

    img.team-crest {
        object-fit: contain;
        background: none;
        padding: 0;
        box-shadow: none;
    }

    .team-name {
        display: block;
        color: var(--text);
        font-weight: 600;
        line-height: 1.2;
    }

    .team-code {
        color: var(--dim);
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: .04em;
    }

    .city-cell small {
        display: block;
        color: var(--dim);
        font-size: .78rem;
    }

    .swatches {
        display: inline-flex;
    }

    .swatch {
        width: 18px;
        height: 18px;
        border: 2px solid var(--white);
        border-radius: 50%;
        background: var(--c);
        box-shadow: 0 0 0 1px var(--line-strong);
    }

        .swatch + .swatch {
            margin-left: -6px;
        }

    .badge-a--active {
        background: var(--it-green-soft);
        color: var(--it-green);
    }

        .badge-a--active::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--it-green);
        }

    .badge-a--inactive {
        background: #EDF0F5;
        color: var(--muted);
    }

    .region {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--muted);
        font-size: .78rem;
    }

        .region::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 2px;
            background: var(--rc);
        }

    .region--north {
        --rc: var(--it-green);
    }

    .region--center {
        --rc: #9AA5B8;
    }

    .region--south {
        --rc: var(--it-red);
    }

    .region--island {
        --rc: var(--blue);
    }

    .crest-preview {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
        padding: 14px 16px;
        border: 1px dashed var(--line-strong);
        border-radius: var(--radius);
        background: #FAFBFD;
    }

    .crest-preview__name {
        display: block;
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .crest-preview__meta {
        color: var(--muted);
        font-size: .85rem;
    }

    .form-field.has-error .field-hint {
        display: none;
    }

    .color-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .color-input {
        display: flex;
        align-items: center;
        gap: 10px;
        height: 38px;
        padding: 0 6px;
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-sm);
    }

        .color-input input[type="color"] {
            width: 30px;
            height: 26px;
            padding: 0;
            border: 0;
            background: none;
            cursor: pointer;
        }

        .color-input code {
            color: var(--text-2);
            font-size: .85rem;
        }

    .form-field.has-error .color-input {
        border-color: var(--it-red);
    }

    .code-input {
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 600;
    }

    @@media (max-width: 1100px) {
        .league-strip {
            grid-template-columns: 1fr 1fr;
        }

        .strip-item:nth-child(3) {
            border-left: 0;
        }
    }

    @@media (max-width: 575.98px) {
        .color-row {
            grid-template-columns: 1fr;
        }

        .strip-item {
            padding: 10px 12px;
        }
    }
</style>
<div class="page-head">
    <div>
        <span class="page-eyebrow">Serie A 2026/27</span>
        <h1 class="page-title">Takım Yönetimi</h1>
        <p class="page-desc">Serie A kulüplerini görüntüleyebilir, ekleyebilir, düzenleyebilir ve silebilirsiniz.</p>
    </div>
    <button type="button" class="btn-a btn-a--primary" data-open-create>
        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>Yeni Takım Ekle
    </button>
</div>

<!-- Partial: _LeagueStrip (kompakt lig özeti) -->
<section class="league-strip" aria-label="Lig özeti" data-league-strip></section>

<!-- ===== Partial: _TeamTable (filtre + tablo) ===== -->
<section class="card-a" aria-label="Takım listesi">
    <form class="filter-bar" data-filter-form role="search">
        <div class="filter-search">
            <label class="field-label" for="f-q">Takım Ara</label>
            <div class="input-icon">
                <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
                <input class="input-a" id="f-q" name="q" type="search" placeholder="Takım, şehir veya stadyum" autocomplete="off">
            </div>
        </div>
        <div>
            <label class="field-label" for="f-region">Bölge</label>
            <select class="select-a" id="f-region" name="region">
                <option value="">Tüm Bölgeler</option>
                <option value="north">Kuzey İtalya</option>
                <option value="center">Orta İtalya</option>
                <option value="south">Güney İtalya</option>
                <option value="island">Adalar</option>
            </select>
        </div>
        <div>
            <label class="field-label" for="f-status">Durum</label>
            <select class="select-a" id="f-status" name="status">
                <option value="">Tümü</option>
                <option value="active">Aktif (Serie A)</option>
                <option value="inactive">Pasif</option>
            </select>
        </div>
        <div class="filter-actions">
            <button type="button" class="btn-a btn-a--ghost" data-filter-reset>Temizle</button>
            <button type="submit" class="btn-a btn-a--secondary">Filtrele</button>
        </div>
    </form>

    <div class="table-scroll">
        <table class="team-table">
            <caption class="visually-hidden">Serie A takım listesi</caption>
            <thead>
                <tr>
                    <th scope="col" class="col-id" data-sort-col="id" aria-sort="ascending"><button type="button" class="sort-btn" data-sort="id">ID</button></th>
                    <th scope="col" data-sort-col="name"><button type="button" class="sort-btn" data-sort="name">Takım</button></th>
                    <th scope="col">Şehir / Bölge</th>
                    <th scope="col">Stadyum</th>
                    <th scope="col" class="col-num" data-sort-col="capacity"><button type="button" class="sort-btn" data-sort="capacity">Kapasite</button></th>
                    <th scope="col" class="col-num" data-sort-col="founded"><button type="button" class="sort-btn" data-sort="founded">Kuruluş</button></th>
                    <th scope="col">Renkler</th>
                    <th scope="col">Durum</th>
                    <th scope="col" class="col-actions">İşlemler</th>
                </tr>
            </thead>


            <tbody data-team-rows>
                @foreach (var t in Model)
                {
                    <tr data-id="${@t.Id}" class="${t.status === 'inactive' ? 'is-inactive' : ''}${t.id === highlightId ? ' is-new' : ''}">
                        <td class="col-id">@t.Id</td>
                        <td>
                            <div class="team-cell">
                                <span class="team-crest">
                                    <img src="@t.LogoUrl"
                                         alt="@t.Name logosu"
                                         style="width: 32px; height: 32px; object-fit: contain;"
                                         onerror="this.style.display='none';" />
                                </span>

                                <div>
                                    <span class="team-name">@t.Name</span>
                                </div>
                            </div>
                        </td>
                        <td class="city-cell">@t.City</td>
                        <td>@t.Stadium</td>
                        <td class="col-num">@t.Capacity</td>
                        <td class="col-num">@t.Founded</td>
                        <td><span class="swatches" title="${@t.ColorA} / ${@t.ColorB}"><span class="swatch" style="--c: @t.ColorA"></span><span class="swatch" style="--c:@t.ColorB"></span></span></td>
                        <td>
                            <span class="badge-a badge-a--@(t.IsActive ? "active" : "passive")">
                                @(t.IsActive ? "Aktif" : "Pasif")
                            </span>
                        </td>

                        <td class="col-actions">
                            <div class="row-actions">
                                <a class="act-btn"
                                   asp-area="Admin"
                                   asp-controller="Team"
                                   asp-action="Detail"
                                   asp-route-id="@t.Id"
                                   title="Detay"
                                   aria-label="Detay: @t.Name">
                                    <i class="fa-solid fa-eye"></i>
                                </a>

                                <a class="act-btn"
                                   asp-area="Admin"
                                   asp-controller="Team"
                                   asp-action="Update"
                                   asp-route-id="@t.Id"
                                   title="Düzenle"
                                   aria-label="Düzenle: @t.Name">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>

                                <form action="/Admin/Team/Delete/@t.Id"
                                      method="post"
                                      onsubmit="return confirm('Bu takımı silmek istediğine emin misin?');">

                                    <button type="submit"
                                            class="act-btn act-btn--danger"
                                            title="Sil"
                                            aria-label="Sil: @t.Name">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
    <div class="table-foot">
        <span data-result-count></span>
        <span>Serie A'da en fazla 20 aktif takım bulunabilir</span>
    </div>
</section>

<!-- ===== Partial: _CreateTeamModal (ekleme + düzenleme) ===== -->
<dialog class="modal-a" id="team-modal" aria-labelledby="team-modal-title">
    <form data-team-form novalidate>
        <div class="modal-head">
            <h2 class="modal-title" id="team-modal-title">Yeni Takım Ekle</h2>
            <button type="button" class="icon-btn" data-modal-close aria-label="Kapat"><svg class="icon" aria-hidden="true"><use href="#i-x" /></svg></button>
        </div>
        <div class="modal-body">
            <div class="form-alert" data-form-alert role="alert">Lütfen işaretli alanları kontrol edin.</div>

            <div class="crest-preview" aria-live="polite">
                <span class="team-crest team-crest--lg" data-preview-crest aria-hidden="true">---</span>
                <div>
                    <span class="crest-preview__name" data-preview-name>Takım adı</span>
                    <span class="crest-preview__meta" data-preview-meta>Şehir, stadyum</span>
                </div>
            </div>

            <input type="hidden" name="id">
            <div class="form-grid">
                <div class="form-field" data-field="name">
                    <label class="field-label" for="t-name">Takım Adı <span class="req">*</span></label>
                    <input class="input-a" id="t-name" name="name" type="text" maxlength="40" placeholder="Örn. Sampdoria" autocomplete="off">
                    <p class="field-error"></p>
                </div>
                <div class="form-field" data-field="code">
                    <label class="field-label" for="t-code">Kısa Ad <span class="req">*</span></label>
                    <input class="input-a code-input" id="t-code" name="code" type="text" maxlength="3" placeholder="SAM" autocomplete="off">
                    <p class="field-hint">Tabloda ve armada görünen 3 harfli kod</p>
                    <p class="field-error"></p>
                </div>
                <div class="form-field" data-field="city">
                    <label class="field-label" for="t-city">Şehir <span class="req">*</span></label>
                    <input class="input-a" id="t-city" name="city" type="text" placeholder="Örn. Genova" autocomplete="off">
                    <p class="field-error"></p>
                </div>
                <div class="form-field" data-field="region">
                    <label class="field-label" for="t-region">Bölge <span class="req">*</span></label>
                    <select class="select-a" id="t-region" name="region">
                        <option value="">Bölge seçin</option>
                        <option value="north">Kuzey İtalya</option>
                        <option value="center">Orta İtalya</option>
                        <option value="south">Güney İtalya</option>
                        <option value="island">Adalar</option>
                    </select>
                    <p class="field-error"></p>
                </div>
                <div class="form-field span-2" data-field="stadium">
                    <label class="field-label" for="t-stadium">Stadyum <span class="req">*</span></label>
                    <input class="input-a" id="t-stadium" name="stadium" type="text" placeholder="Örn. Stadio Luigi Ferraris" autocomplete="off">
                    <p class="field-error"></p>
                </div>
                <div class="form-field" data-field="capacity">
                    <label class="field-label" for="t-capacity">Stadyum Kapasitesi <span class="req">*</span></label>
                    <input class="input-a" id="t-capacity" name="capacity" type="number" min="1000" max="100000" step="1" inputmode="numeric" placeholder="Örn. 36599">
                    <p class="field-error"></p>
                </div>
                <div class="form-field" data-field="founded">
                    <label class="field-label" for="t-founded">Kuruluş Yılı <span class="req">*</span></label>
                    <input class="input-a" id="t-founded" name="founded" type="number" min="1850" max="2026" step="1" inputmode="numeric" placeholder="Örn. 1946">
                    <p class="field-error"></p>
                </div>
                <div class="form-field span-2" data-field="colors">
                    <span class="field-label">Kulüp Renkleri <span class="req">*</span></span>
                    <div class="color-row">
                        <label class="color-input">
                            <input type="color" name="colorA" value="#1E5BD8" aria-label="Ana renk">
                            <span>Ana renk <code data-color-a>#1E5BD8</code></span>
                        </label>
                        <label class="color-input">
                            <input type="color" name="colorB" value="#FFFFFF" aria-label="İkinci renk">
                            <span>İkinci renk <code data-color-b>#FFFFFF</code></span>
                        </label>
                    </div>
                    <p class="field-error"></p>
                </div>
                <div class="form-field span-2" data-field="status">
                    <label class="field-label" for="t-status">Durum</label>
                    <select class="select-a" id="t-status" name="status">
                        <option value="active">Aktif (Serie A'da oynuyor)</option>
                        <option value="inactive">Pasif</option>
                    </select>
                    <p class="field-hint" data-status-hint></p>
                    <p class="field-error"></p>
                </div>
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn-a btn-a--secondary" data-modal-close>Vazgeç</button>
            <button type="submit" class="btn-a btn-a--primary">Kaydet</button>
        </div>
    </form>
</dialog>



@section Scripts {
    <script>
        (() => {
            'use strict';

            const $ = (selector, root = document) =>
                root.querySelector(selector);

            const esc = value =>
                String(value).replace(/[&<>"']/g, character => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                })[character]);

            const norm = value =>
                String(value)
                    .toLocaleLowerCase('tr-TR')
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '');

            const num = value =>
                new Intl.NumberFormat('tr-TR').format(value);

            const icon = id =>
                `<svg class="icon" aria-hidden="true"><use href="#i-${id}"/></svg>`;

            /*
             * Takım verilerini kullanan fonksiyonları burada tut.
             * teams ve els değişkenlerini kullanan kodlar,
             * bu değişkenlerin tanımlandığı mevcut bölümle birlikte taşınmalı.
             */

            // Mobil sidebar
            const toggleBtn = $('[data-sidebar-toggle]');
            const closeBtn = $('[data-sidebar-close]');

            function setSidebar(open) {
                document.body.classList.toggle('sidebar-open', open);
                toggleBtn?.setAttribute('aria-expanded', String(open));
            }

            toggleBtn?.addEventListener('click', () => {
                setSidebar(!document.body.classList.contains('sidebar-open'));
            });

            closeBtn?.addEventListener('click', () => {
                setSidebar(false);
            });

            document.addEventListener('keydown', event => {
                if (event.key === 'Escape') {
                    setSidebar(false);
                }
            });
        })();
    </script>
}
