@using SerieA.WebUI.Areas.Admin.Models.MatchModels
@model List<MatchListViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>
    /* ============================================================
       Match/Index.cshtml — maça özel CSS ve ortak stillerin Match farkları
       ============================================================ */

    .sidebar-link--logout:hover {
        background: rgba(210, 59, 78, .18);
    }

    .notif-dot {
        background: var(--red);
    }

    .page-head {
        margin-bottom: 20px;
    }

    .btn-a--danger {
        background: var(--red);
    }

        .btn-a--danger:hover {
            background: #B52F41;
        }

    .match-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
    }

        .match-table th {
            padding: 10px 14px;
            border-bottom: 1px solid var(--line);
            background: #F8FAFC;
            color: var(--muted);
            font-size: .78rem;
            font-weight: 600;
            text-align: left;
            white-space: nowrap;
        }

        .match-table td {
            padding: 9px 14px;
            border-bottom: 1px solid var(--line);
            color: var(--text-2);
            vertical-align: middle;
            white-space: nowrap;
        }

        .match-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .match-table tbody tr:hover td {
            background: var(--row-hover);
        }

        .match-table tbody tr.is-new td {
            animation: row-flash 2.4s ease-out;
        }

    .col-id {
        width: 64px;
        color: var(--dim);
    }

        .col-id span {
            color: var(--muted);
            font-weight: 600;
        }

    .col-score {
        text-align: center !important;
        width: 84px;
    }

    .col-actions {
        width: 1%;
        text-align: right !important;
    }

    .team {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: var(--text);
        font-weight: 600;
    }

    .team-crest {
        width: 22px;
        height: 22px;
        flex: none;
        border-radius: 50%;
        background: linear-gradient(180deg, var(--crest-a) 0 68%, var(--crest-b) 68% 100%);
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .12);
    }

    img.team-crest {
        object-fit: contain;
        background: none;
        box-shadow: none;
    }

    .score {
        display: inline-block;
        min-width: 56px;
        padding: 3px 8px;
        border-radius: 6px;
        background: var(--bg);
        color: var(--text);
        font-weight: 700;
        text-align: center;
    }

    .score--empty {
        background: transparent;
        color: var(--dim);
        font-weight: 500;
    }

    .week-cell {
        color: var(--text-2);
    }

    .badge-a--NotStarted {
        background: #EDF2F9;
        color: #4B5E80;
    }

    .badge-a--Live {
        background: var(--green-soft);
        color: var(--green);
    }

        .badge-a--Live::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
        }

    .badge-a--Finished {
        background: #E3E9F4;
        color: var(--navy-700);
    }

    .badge-a--Postponed {
        background: var(--amber-soft);
        color: var(--amber);
    }

    .act-btn--danger:hover {
        background: var(--red-soft);
        color: var(--red);
    }

    .modal-a {
        width: min(640px, calc(100vw - 32px));
    }

        .modal-a form {
            max-height: inherit;
        }

    .modal-head {
        padding: 16px 20px;
    }

    .modal-body {
        padding: 18px 20px 6px;
    }

    .modal-foot {
        border-radius: 0 0 12px 12px;
    }

    .req {
        color: var(--red);
    }

    .field-error {
        color: var(--red);
    }

    .form-field.has-error .input-a,
    .form-field.has-error .select-a {
        border-color: var(--red);
        box-shadow: 0 0 0 3px rgba(210, 59, 78, .12);
    }

    .score-fields {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px 16px;
    }

        .score-fields[hidden] {
            display: none;
        }

    .form-alert {
        background: var(--red-soft);
    }

    .confirm-text {
        margin: 0 0 12px;
    }
</style>
<div class="page-head">
    <div><span class="page-eyebrow">Serie A 2026/27</span><h1 class="page-title">Maç Yönetimi</h1><p class="page-desc">Serie A karşılaşmalarını görüntüleyebilir, ekleyebilir, düzenleyebilir ve silebilirsiniz.</p></div>
    <button type="button" class="btn-a btn-a--primary" data-open-create><svg class="icon"><use href="#i-plus" /></svg>Yeni Maç Ekle</button>
</div>

<section class="card-a" aria-label="Maç listesi">
    <form class="filter-bar" id="filter-form">
        <div>
            <label class="field-label" for="f-team">Takım Ara</label>
            <div class="input-icon"><i class="fa-solid fa-magnifying-glass"></i><input class="input-a" id="f-team" name="team" type="search" placeholder="Takım adı yazın" autocomplete="off" /></div>
        </div>
        <div><label class="field-label" for="f-week">Hafta Seç</label><select class="select-a" id="f-week" name="week"><option value="">Tüm Haftalar</option></select></div>
        <div><label class="field-label" for="f-status">Durum</label><select class="select-a" id="f-status" name="status"><option value="">Tümü</option><option value="NotStarted">Başlamadı</option><option value="Live">Canlı</option><option value="Finished">Tamamlandı</option><option value="Postponed">Ertelendi</option></select></div>
        <div class="filter-actions"><button type="button" class="btn-a btn-a--ghost" id="filter-reset">Temizle</button><button type="submit" class="btn-a btn-a--secondary">Filtrele</button></div>
    </form>

    <div class="table-scroll">
        <table class="match-table">
            <caption class="visually-hidden">Serie A maç listesi</caption>
            <thead><tr><th>ID</th><th>Hafta</th><th>Tarih</th><th>Ev Sahibi</th><th class="col-score">Skor</th><th>Deplasman</th><th>Stadyum</th><th>Durum</th><th class="col-actions">İşlemler</th></tr></thead>
            <tbody id="match-rows">
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var m in Model)
                    {
                        <tr data-id="@m.Id" data-week="@m.Week" data-status="@m.Status" data-home="@m.HomeName" data-away="@m.AwayName">
                            <td class="col-id"><span>@m.Id</span></td>
                            <td>@m.Week</td>
                            <td>@m.MatchDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@m.HomeName</td>
                            <td class="col-score"><span class="score">@m.HomeScore - @m.AwayScore</span></td>
                            <td>@m.AwayName</td>
                            <td>@m.Stadium</td>
                            <td><span class="badge-a badge-a--@m.Status">@m.Status</span></td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <a class="act-btn" asp-area="Admin" asp-controller="Match" asp-action="Detail" asp-route-id="@m.Id" title="Detay" aria-label="Maç detayı"><i class="fa-regular fa-eye"></i></a>
                                    <a class="act-btn" asp-area="Admin" asp-controller="Match" asp-action="Update" asp-route-id="@m.Id" title="Düzenle" aria-label="Maçı düzenle"><i class="fa-regular fa-pen-to-square"></i></a>
                                    <form action="/Admin/Match/Delete/@m.Id" method="post" class="d-inline" onsubmit="return confirm('Bu maçı silmek istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="act-btn act-btn--danger" title="Sil" aria-label="Maçı sil"><i class="fa-regular fa-trash-can"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="empty-state">Henüz maç kaydı bulunmuyor.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-foot"><span id="result-count">@((Model?.Count) ?? 0) maç listeleniyor</span><span>Sezon 2026/27</span></div>
</section>

<dialog class="modal-a" id="match-modal" aria-labelledby="match-modal-title">
    <form method="post" action="/Admin/Match/Create" id="match-form">

        <div class="modal-head">
            <h2 class="modal-title" id="match-modal-title">Yeni Maç Ekle</h2>
            <button type="button" class="icon-btn" data-modal-close aria-label="Kapat"><svg class="icon"><use href="#i-x" /></svg></button>
        </div>
        <div class="modal-body">
            <div class="form-grid">
                <div class="form-field span-2"><label class="field-label" for="m-week">Hafta <span class="req">*</span></label><input class="input-a" id="m-week" name="Week" type="text" placeholder="Örn. 1. Hafta" required /></div>


                <div class="form-field">
                    <label class="field-label" for="m-status">Maç Durumu</label>

                    <select class="select-a" id="m-status" name="Status" required>
                        <option value="">Maç durumu seçin</option>
                        <option value="Scheduled">Oynanacak</option>
                        <option value="Live">Canlı</option>
                        <option value="Finished">Tamamlandı</option>
                        <option value="Postponed">Ertelendi</option>
                        <option value="Cancelled">İptal edildi</option>
                    </select>
                </div>


                <div class="form-field"><label class="field-label" for="m-date">Maç Tarihi <span class="req">*</span></label><input class="input-a" id="m-date" name="MatchDate" type="datetime-local" required /></div>

                <div class="form-field">
                    <label class="field-label" for="m-home-team">Ev Sahibi Takım <span class="req">*</span></label>
                    <select id="m-home-team" name="HomeTeamId" class="select-a" required>
                        <option value="">Ev sahibi takım seçin</option>
                        @if (ViewBag.Teams != null)
                        {
                            foreach (var team in ViewBag.Teams)
                            {
                                <option value="@team.Id">@team.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-field">
                    <label class="field-label" for="m-away-team">Deplasman Takımı <span class="req">*</span></label><select id="m-away-team" name="AwayTeamId" class="select-a" required>
                        <option value="">Deplasman takımı seçin</option>@if (ViewBag.Teams != null) { foreach (var team in ViewBag.Teams) {
                        <option value="@team.Id">@team.Name</option>
                                                } }
                    </select>
                </div>
                <div class="form-field"><label class="field-label" for="m-hs">Ev Sahibi Skoru</label><input class="input-a" id="m-hs" name="HomeScore" type="number" min="0" max="20" value="0" /></div>
                <div class="form-field"><label class="field-label" for="m-as">Deplasman Skoru</label><input class="input-a" id="m-as" name="AwayScore" type="number" min="0" max="20" value="0" /></div>
                <div class="form-field span-2"><label class="field-label" for="m-stadium">Stadyum</label><input class="input-a" id="m-stadium" name="Stadium" type="text" placeholder="Stadyum adı" /></div>
            </div>
            <p class="field-hint">Ev sahibi ve deplasman takımları farklı olmalıdır.</p>
        </div>
        <div class="modal-foot"><button type="button" class="btn-a btn-a--secondary" data-modal-close>Vazgeç</button><button type="submit" class="btn-a btn-a--primary">Kaydet</button></div>
    </form>
</dialog>



@section Scripts {
    <script>
        (() => {
            const modal = document.getElementById('match-modal');
            const openButton = document.querySelector('[data-open-create]');
            const form = document.getElementById('match-form');
            const rows = document.getElementById('match-rows');
            const filterForm = document.getElementById('filter-form');
            const resetButton = document.getElementById('filter-reset');
            const resultCount = document.getElementById('result-count');
            const weekFilter = document.getElementById('f-week');
            const statusFilter = document.getElementById('f-status');
            const teamFilter = document.getElementById('f-team');
            const homeSelect = document.getElementById('m-home-team');
            const awaySelect = document.getElementById('m-away-team');
            const scoreInputs = [
                document.getElementById('m-hs'),
                document.getElementById('m-as')
            ];

            // Maç ekleme modalı
            openButton?.addEventListener('click', () => {
                if (!modal) return;

                if (typeof modal.showModal === 'function') {
                    modal.showModal();
                } else {
                    modal.setAttribute('open', '');
                }
            });

            document.querySelectorAll('[data-modal-close]').forEach(button => {
                button.addEventListener('click', () => modal?.close());
            });

            modal?.addEventListener('click', event => {
                if (event.target === modal) modal.close();
            });

            // Ev sahibi ve deplasman aynı takım olamaz
            function validateTeams() {
                if (!homeSelect || !awaySelect) return;

                if (
                    homeSelect.value &&
                    awaySelect.value &&
                    homeSelect.value === awaySelect.value
                ) {
                    awaySelect.setCustomValidity(
                        'Ev sahibi ve deplasman takımları aynı olamaz.'
                    );
                } else {
                    awaySelect.setCustomValidity('');
                }
            }

            homeSelect?.addEventListener('change', validateTeams);
            awaySelect?.addEventListener('change', validateTeams);

            // Skor alanlarının görsel durumu
            document.getElementById('m-status')?.addEventListener('change', event => {
                const showScores =
                    event.target.value === 'Live' ||
                    event.target.value === 'Finished';

                scoreInputs.forEach(input => {
                    if (!input) return;

                    const field = input.closest('.form-field');
                    if (field) {
                        field.style.opacity = showScores ? '1' : '.75';
                    }
                });
            });

            // Haftaları mevcut maç kayıtlarından oluştur
            if (rows && weekFilter) {
                const weeks = [
                    ...new Set(
                        [...rows.querySelectorAll('tr[data-week]')]
                            .map(row => row.dataset.week)
                            .filter(Boolean)
                    )
                ].sort((a, b) => Number.parseInt(a) - Number.parseInt(b));

                weeks.forEach(week => {
                    const option = document.createElement('option');
                    option.value = week;
                    option.textContent = `${week} Hafta`;
                    weekFilter.appendChild(option);
                });
            }

            filterForm?.addEventListener('submit', event => {
                event.preventDefault();
                filterRows();
            });

            resetButton?.addEventListener('click', () => {
                filterForm?.reset();
                filterRows();
            });

            function filterRows() {
                if (!rows) return;

                const team = teamFilter?.value
                    .trim()
                    .toLocaleLowerCase('tr-TR') ?? '';

                const week = weekFilter?.value ?? '';
                const status = statusFilter?.value ?? '';
                let visible = 0;

                rows.querySelectorAll('tr[data-id]').forEach(row => {
                    const teamMatches =
                        !team ||
                        ((row.dataset.home ?? '') + ' ' +
                         (row.dataset.away ?? ''))
                            .toLocaleLowerCase('tr-TR')
                            .includes(team);

                    const weekMatches =
                        !week || row.dataset.week === week;

                    const statusMatches =
                        !status || row.dataset.status === status;

                    const show =
                        teamMatches && weekMatches && statusMatches;

                    row.hidden = !show;

                    if (show) visible++;
                });

                if (resultCount) {
                    resultCount.textContent = `${visible} maç listeleniyor`;
                }
            }
        })();
    </script>
}
